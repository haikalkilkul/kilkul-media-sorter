{
  "name": "kilkul-media-sorter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "test": "tsx --test tests/filename.test.ts tests/discovery.test.ts tests/media-details.test.ts tests/video-seek.test.ts tests/move.test.ts tests/rename.test.ts tests/rename-queue.test.ts tests/batch-ui.test.ts tests/queue-navigation.test.ts",
    "start:server": "tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
